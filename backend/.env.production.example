# Copy to backend/.env.production (it is git-ignored) and fill in the values from Neon and Cloudflare R2.
# Used by scripts/publish-content.ps1 to fill the hosted site from this computer. Never commit the real file.

# Neon -> your project -> Connection string (choose "Pooled connection"), e.g.
# postgresql://neondb_owner:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Cloudflare -> R2 -> your bucket. Account ID is shown on the R2 overview page.
R2_ACCOUNT_ID=
R2_BUCKET=
# R2 -> Manage API tokens -> Create token with "Object Read & Write" for this bucket.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2 -> bucket -> Settings -> Public Development URL (pub-xxxx.r2.dev) or your own media domain.
R2_PUBLIC_DOMAIN=
