DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

FRONTEND_URL=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=

DATABASE_ENGINE=sqlite
SQLITE_PATH=
POSTGRES_DB=kyrgyzstan_tours
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DJANGO_MEDIA_ROOT=
DJANGO_MEDIA_URL=/media/
DJANGO_SERVE_MEDIA=false
DJANGO_SERVE_FRONTEND=false
FRONTEND_DIST=
MEDIA_MAX_IMAGE_SIZE_MB=12
MEDIA_MAX_VIDEO_SIZE_MB=80

DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@example.com
INQUIRY_NOTIFICATION_EMAILS=

THROTTLE_PUBLIC_READ=600/minute
THROTTLE_PUBLIC_FORMS=20/hour
THROTTLE_LOGIN=10/minute

DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=2592000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
