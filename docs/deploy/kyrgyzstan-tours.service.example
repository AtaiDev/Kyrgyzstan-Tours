[Unit]
Description=Kyrgyzstan-Tours backend (Gunicorn)
After=network.target postgresql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/srv/kyrgyzstan-tours/backend
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
EnvironmentFile=/srv/kyrgyzstan-tours/backend/.env
ExecStart=/srv/kyrgyzstan-tours/backend/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 3 --timeout 120 --access-logfile -
Restart=on-failure

[Install]
WantedBy=multi-user.target
